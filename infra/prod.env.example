# Copy to prod.env OUTSIDE version control and fill with real, unique values.
# Generate secrets with:  openssl rand -base64 48
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
MFA_ENCRYPTION_KEY=          # must differ from JWT_ACCESS_SECRET
CORS_ORIGIN=https://app.example.com,https://admin.example.com
PUBLIC_API_URL=https://api.example.com   # baked into the web/admin builds
TRUST_PROXY=1                # number of reverse-proxy hops in front of the API
