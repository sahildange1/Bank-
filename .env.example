# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/corporate_banking?schema=public"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
SESSION_SECRET="replace-with-a-long-random-value"
JWT_ACCESS_SECRET="replace-with-a-long-random-value"
MFA_ENCRYPTION_KEY="replace-with-a-32-byte-key"

# --- App ---
NODE_ENV="development"
API_PORT=4000
WEB_PORT=3000
ADMIN_PORT=3001
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# --- Mock payment provider ---
MOCK_PAYMENT_PROVIDER_LATENCY_MS=500
MOCK_PAYMENT_PROVIDER_FAILURE_RATE=0.05

# --- Object storage (local/dev stub) ---
OBJECT_STORAGE_ENDPOINT="http://localhost:9000"
OBJECT_STORAGE_BUCKET="corporate-banking-documents"
OBJECT_STORAGE_ACCESS_KEY=""
OBJECT_STORAGE_SECRET_KEY=""

# --- Email (dev: use a local mail catcher e.g. Mailhog) ---
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_FROM="no-reply@corporate-banking.local"
